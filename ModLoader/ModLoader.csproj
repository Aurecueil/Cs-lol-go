<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\holyanimegurlthetrueonereallychosengodblessheramen\animegurl.ico</ApplicationIcon>
    <StartupObject>ModManager.App</StartupObject>
    <UseWindowsForms>False</UseWindowsForms>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <FileVersion>2.20.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="RuneforgeFont.ttf" />
  </ItemGroup>

	<ItemGroup>
		<None Include="..\holyanimegurlthetrueonereallychosengodblessheramen\animegurl.ico">
			<Link>animegurl.ico</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Tools\**\*" Exclude="..\Tools\game-data-overlay.exe">
			<Link>cslol-tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

  <ItemGroup>
    <None Include="..\game-data-overlay\target\release\game-data-overlay.exe" Link="cslol-tools\game-data-overlay.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildGameDataOverlay" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipGameDataBuild)' != 'true'">
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(MSBuildProjectDirectory)\..\game-data-overlay\Cargo.toml&quot;" />
  </Target>


	<ItemGroup>
		<None Include="..\Resources\**\*">
			<Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	
	<ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
    <PackageReference Include="Imazen.WebP" Version="10.0.1" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>

</Project>
